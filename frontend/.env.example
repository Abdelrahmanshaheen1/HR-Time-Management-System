# Copy to frontend/.env.local. Never commit the real file.

# Base URL of the running backend API (the backend defaults to port 3000).
# Several pages fall back to a hard-coded localhost URL when this is unset,
# and a few of those fallbacks point at port 5000, so set it explicitly.
NEXT_PUBLIC_API_URL=http://localhost:3000

# The onboarding/offboarding/performance services read these instead.
# Keep them equal to NEXT_PUBLIC_API_URL (they fall back to http://localhost:3000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
