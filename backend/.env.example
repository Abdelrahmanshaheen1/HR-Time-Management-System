# Copy to backend/.env and adjust. Never commit the real .env file.

# MongoDB connection string (default if unset: mongodb://localhost:27017/hr-main)
MONGODB_URI=mongodb://localhost:27017/hr-main

# Secret used to sign JWTs. SET THIS. If it is missing, the code falls back to a
# hard-coded development secret, which is fine locally and unsafe anywhere else.
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (default: 3000)
PORT=3000

# --- Optional: leave-request e-mail notifications (Common/email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
# Base URL of the frontend, used for links inside the e-mails
FRONTEND_URL=http://localhost:3001
# Where leave-pattern alerts are sent (default: hr@company.com)
HR_NOTIFICATION_EMAIL=hr@example.com
